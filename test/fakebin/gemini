#!/usr/bin/env node
// Fake Gemini CLI: stream-json. Behaviour via FAKE_GEMINI=good|cheat|quota|bad, FAKE_SLEEP=ms
const fs = require('fs');
const args = process.argv.slice(2);
if (args[0] === '--version') { console.log('0.0.0-fake'); process.exit(0); } const ri = args.indexOf('-r');
let input = ''; process.stdin.on('data', (d) => (input += d)); process.stdin.on('end', async () => {
  const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
  const mode = process.env.FAKE_GEMINI || 'good';
  if (mode === 'quota') { process.stderr.write('Error: 429 RESOURCE_EXHAUSTED: Quota exceeded for model\n'); process.exit(1); }
  out({ type: 'init', session_id: ri >= 0 ? args[ri + 1] : 'gm-' + Math.random().toString(36).slice(2, 8), model: 'fake-gemini' });
  if (process.env.FAKE_SLEEP) await new Promise((r) => setTimeout(r, Number(process.env.FAKE_SLEEP)));
  fs.mkdirSync('src', { recursive: true });
  const second = /REVIEWER FEEDBACK FROM ROUND/.test(input);
  if (mode === 'cheat' && !second) {
    fs.writeFileSync('src/add.sh', 'echo 5\n'); fs.writeFileSync('tests/existing.sh', 'exit 0 # hacked\n');
  } else if (mode === 'bad') {
    fs.writeFileSync('src/add.sh', 'echo 4\n'); fs.writeFileSync('tests/test_add.sh', '[ "$(bash src/add.sh 2 3)" = 5 ]\n');
  } else {
    try { require('child_process').execSync('git checkout -q -- tests/existing.sh', { stdio: 'ignore' }); } catch {}
    fs.writeFileSync('src/add.sh', 'echo $(( $1 + $2 ))\n'); fs.writeFileSync('tests/test_add.sh', '[ "$(bash src/add.sh 2 3)" = 5 ]\n');
  }
  out({ type: 'tool_use', tool_name: 'write_file', tool_id: 't1', parameters: { file_path: 'src/add.sh' } });
  out({ type: 'tool_result', tool_id: 't1', status: 'success' });
  out({ type: 'message', role: 'assistant', content: 'Implemented add.', delta: false });
  out({ type: 'result', status: 'success', stats: { total_tokens: 9000, input_tokens: 8000, output_tokens: 1000 } });
});
